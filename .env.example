# Server-only configuration. Never prefix secrets with NEXT_PUBLIC_.
# Fill these in privately in .env.local or your deployment environment.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TRANSFER_CODE_SECRET=
# Optional: set only if your deployment proxy overwrites this header reliably.
# TRANSFER_TRUSTED_IP_HEADER=
# Likes and feedback reuse SUPABASE_URL and SUPABASE_SECRET_KEY above.
# Optional separate 64-hex signing secret; defaults to TRANSFER_CODE_SECRET.
# ENGAGEMENT_SECRET=
# Set only when your deployment proxy overwrites this header reliably.
# ENGAGEMENT_TRUSTED_IP_HEADER=
